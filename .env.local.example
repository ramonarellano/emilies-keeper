# Kopier til .env.local og fyll inn. .env.local sjekkes aldri inn.
# Verdiene finnes i Supabase under Project Settings → API.
# Den publiserbare nøkkelen er ment for nettleseren. service_role-nøkkelen skal ALDRI hit.
NEXT_PUBLIC_SUPABASE_URL=https://<prosjekt>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
